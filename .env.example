# Environment Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# SMSEthiopia Gateway Configuration (Free 100 Test SMS on Signup)
# 1. Sign up for free at https://smsethiopia.com/#/auth/sign-up
# 2. Verify your Ethiopian mobile phone number (unlocks 100 free SMS + pre-verifies your number)
# 3. Go to Console -> API Keys -> click "New API Key" (scoped to your test campaign)
# 4. Copy the 40-character API key and paste below:
SMS_ETHIOPIA_API_KEY=
SMS_SENDER_NAME=Tenaye Alert

# AfroMessage Gateway (Optional Fallback)
AFROMESSAGE_API_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME=Tenaye Alert
